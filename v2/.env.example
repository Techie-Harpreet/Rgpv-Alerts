# Copy to .env and fill in

# whatsapp_sender.py (WAHA)
WAHA_URL=http://localhost:3000
WAHA_API_KEY=                # leave empty if WAHA has no API key
# Optional: by default every WORKING session and every channel you are ADMIN of is used
WAHA_SESSION=
WHATSAPP_CHAT_ID=            # e.g. 120363000000000000@newsletter

# telegram_bot.py (only if you also run the Telegram bot)
BOT_TOKEN=123456789:your-bot-token-from-botfather
GROUP_ID=-1001234567890
ADMIN_IDS=                   # comma-separated user IDs allowed to use /check and /reset; empty = everyone

NOTICES_LOOKBACK_DAYS=60     # only notices from the last N days are considered

# Cloudflare R2 for sent lists (optional; without it they are kept in DATA_DIR)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PREFIX=rgpv-alerts/

# Shared
CHECK_INTERVAL=7200          # seconds
